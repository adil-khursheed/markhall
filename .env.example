# Core
DATABASE_URL=postgres://markhall:change-me@127.0.0.1:5433/markhall
PAYLOAD_SECRET=change-me-to-a-long-random-string
PAYLOAD_COOKIE_PREFIX=payload

# Docker Compose database (used by the postgres service)
POSTGRES_USER=markhall
POSTGRES_PASSWORD=change-me
POSTGRES_DB=markhall
POSTGRES_PORT=5433
WEB_PORT=3000

# Models (OpenAI-compatible)
# Baseline: Luna for cheap routing/repair, GPT-5.4 mini for code, vision and grading.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
MODEL_DEFAULT=gpt-5.6-luna
MODEL_ROUTER=gpt-5.6-luna
MODEL_SOLVER=gpt-5.4-mini
MODEL_EXPLAINER=gpt-5.4-mini
MODEL_JUDGE=gpt-5.4-mini
MODEL_VISION=gpt-5.4-mini

# Embeddings
# text-embedding-3-large at 1024 dimensions keeps the pgvector schema small
# while remaining multilingual for the later Hindi rollout.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1024
# Optional: use a different OpenAI-compatible endpoint/key for embeddings.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional seed admin (used by `pnpm seed`; no default password)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Services
SANDBOX_URL=http://127.0.0.1:8000
SANDBOX_TIMEOUT_MS=10000
SANDBOX_WORKERS=2
SANDBOX_QUEUE_LIMIT=8
SANDBOX_MEMORY_MB=192
SANDBOX_RATE_LIMIT=60
REDIS_URL=redis://127.0.0.1:6379
JOBS_AUTORUN=false
UPLOADS_DIR=./uploads
